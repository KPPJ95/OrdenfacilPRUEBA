rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /companies/{companyId} {
      allow read, write: if isValidId(companyId);

      match /leads/{leadId} {
        allow read, write: if isValidId(companyId) && isValidId(leadId);

        match /messages/{messageId} {
          allow read, write: if isValidId(companyId) && isValidId(leadId) && isValidId(messageId);
        }
      }
    }

    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
